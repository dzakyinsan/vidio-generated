{
  "name": "canvas-video-template",
  "version": "1.0.0",
  "description": "Template pembuatan video animasi explainer 2D (9:16 TikTok/Reels/Shorts) menggunakan HTML5 Canvas di Node.js",
  "type": "module",
  "scripts": {
    "preview": "node scripts/preview.js",
    "generate:sfx": "node scripts/generateSfx.js",
    "generate:sfx:charge": "node scripts/generateChargeSfx.js",
    "generate:sfx:dinner": "node scripts/generateLateDinnerSfx.js",
    "render": "node scripts/render.js",
    "render:draft": "node scripts/render.js --scale 0.5 --fps 30"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.70",
    "ffmpeg-static": "^5.2.0"
  }
}
